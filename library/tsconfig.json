{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node", "bun"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "files": ["src/library.ts"],
  "exclude": ["node_modules", "dist"]
}
