{
  "name": "netex-deckplans-components",
  "module": "./dist/index.js",
  "description": "Project with all the components to edit and display a deck plan",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run typecheck && vite build && bun run build:types",
    "typecheck": "node scripts/vue-typecheck.cjs -p tsconfig.json --noEmit",
    "dev": "vite",
    "test": "bun test --pass-with-no-tests",
    "build:types": "node scripts/vue-typecheck.cjs -p tsconfig.build.json"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "typescript-vue": "npm:typescript@~6.0.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "netex-deckplan-library": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
